# Jahiv Configuration
# Copy this file to .env and adjust values as needed

# Server
HOST=0.0.0.0
PORT=8000

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=llama3.1
EMBED_MODEL=nomic-embed-text

# Alternative models for low-RAM machines:
# LLM_MODEL=llama3.2:3b
# LLM_MODEL=qwen2.5:3b

# Retrieval
TOP_K=5
CONFIDENCE_THRESHOLD=0.4

# Chunking
CHUNK_SIZE=500
CHUNK_OVERLAP=100

# Memory
SHORT_TERM_LIMIT=6
SUMMARY_TRIGGER=12

# Agent
CRITIC_ENABLED=true

# Storage
DATA_DIR=data
MAX_UPLOAD_SIZE_MB=50
